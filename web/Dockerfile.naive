# Task 6.4 "before" image - deliberately un-optimised, ONLY for the size comparison.
#   docker build -f web/Dockerfile.naive -t vg-naive .
# Full python base (~1 GB), full GPU tensorflow, pip cache kept, whole repo copied before
# installing (so any code edit invalidates the dependency layer), runs as root.
FROM python:3.11
WORKDIR /app
COPY . /app
RUN pip install tensorflow==2.20.0 -r web/requirements.txt
WORKDIR /app/web
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "wsgi:app"]
