# Copy to .env and fill in. .env is git-ignored and docker-ignored.

# --- DagsHub / MLflow (Task 3.2) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<dagshub-user>/23L-0594_A2_Ops.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-access-token>

# --- Postgres (Task 5 / 6.3) ---
POSTGRES_USER=visionguard
POSTGRES_PASSWORD=<long-random-string>
POSTGRES_DB=visionguard

# --- Flask app (Task 4.4) ---
SECRET_KEY=<long-random-string>
INFERENCE_BACKEND=remote            # local = Keras model in the container, remote = Vercel API
THRESHOLD=0.5                       # set from the champion run's 'threshold' param
MODEL_NAME=23L-0594_A2_Ops_visionguard
MODEL_VERSION=1
MAX_UPLOAD_MB=4

# --- Vercel model API (Task 7 / 8) ---
MODEL_API_URL=https://<your-project>.vercel.app
MODEL_API_KEY=<same value as VG_API_KEY set in Vercel>

# Build arg: leave empty when INFERENCE_BACKEND=remote for a much smaller image
TF_PACKAGE=tensorflow-cpu==2.20.0
